# =============================================================================
# AgentFarm — vzor konfigurace. Zkopíruj do `.env` a doplň hodnoty.
#   cp .env.example .env
# Vše, co je označeno [POVINNÉ], musí být vyplněno, aby farma nastartovala.
# Ostatní je potřeba až pro konkrétní fázi (média, Instagram, deploy…).
#
# DASHBOARD nedostává celý tenhle soubor (v compose nemá `env_file`). Předává
# se mu výslovně jen:
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY,
#   PUBLIC_APP_URL, CREDENTIALS_ENCRYPTION_KEY
#   (+ HOSTNAME, PORT, TZ=Europe/Prague natvrdo v compose)
# Když dashboard začne číst novou proměnnou, doplň ji do `environment:` služby
# dashboard v infra/compose/docker-compose.farm.yml — tajemství pro ostatní
# služby (GitHub PAT, klíče modelů, LiteLLM, DATABASE_URL, Stripe) tam nepatří.
# Compose interpoluje z `--env-file`, proto spouštěj s explicitní cestou:
#   docker compose --env-file .env -f infra/compose/docker-compose.farm.yml up -d
# =============================================================================

# --- Prostředí ---------------------------------------------------------------
NODE_ENV=development
# Základní URL dashboardu (kvůli odkazům v Telegramu a přesměrování Auth)
PUBLIC_APP_URL=http://localhost:3000
# Wildcard doména pro preview deploye agentích aplikací (Fáze 4)
PREVIEW_BASE_DOMAIN=farm.example.com

# --- Supabase [POVINNÉ] ------------------------------------------------------
# Z nového, DEDIKOVANÉHO Supabase projektu (ne produkčního!).
# Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...
# Přímé připojení k Postgresu (Project Settings → Database → Connection string → URI)
# Používá Drizzle na migrace a orchestrátor na pgmq.
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres
# LiteLLM spend/log DB (compose: litellm.DATABASE_URL). Jen v .env, nikdy v compose.
LITELLM_DATABASE_URL=postgresql://supabase_admin:CHANGE_ME@agentfarm-supabase-db-1:5432/litellm
# 32bytový klíč (hex) pro šifrování `connections.encrypted_credentials`.
# Vygeneruj:  openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=

# --- LiteLLM proxy [POVINNÉ] -------------------------------------------------
# Proxy běží v compose stacku; master key si zvol libovolně (silný náhodný).
LITELLM_BASE_URL=http://litellm:4000
LITELLM_MASTER_KEY=sk-farm-master-CHANGE-ME
# Salt pro LiteLLM (šifrování uložených klíčů). openssl rand -hex 16
LITELLM_SALT_KEY=

# --- Čínské modely (klíče čte LiteLLM) [POVINNÉ pro běh agentů] --------------
# DeepSeek — https://platform.deepseek.com  (manager + fallback worker + levné pomocné)
DEEPSEEK_API_KEY=
# Z.ai GLM Coding Plan — https://z.ai  (primární worker; anthropic passthrough)
ZAI_API_KEY=
# Moonshot Kimi — https://platform.moonshot.ai  (judge)
MOONSHOT_API_KEY=
# DashScope / Qwen (fallback VLM pro média) — https://dashscope.console.aliyun.com
DASHSCOPE_API_KEY=

# --- Hlasový vstup (jediná ne-čínská výjimka, jen STT) -----------------------
# Groq Whisper — https://console.groq.com
GROQ_API_KEY=

# --- GitHub (git operace orchestrátoru) --------------------------------------
# Fine-grained PAT admina (repo: create/read/write). Ostatní uživatelé si vloží
# vlastní PAT v dashboardu (/settings). https://github.com/settings/tokens
GITHUB_ADMIN_PAT=
# Pod jakým GitHub účtem/orgem zakládat nová repa projektů
GITHUB_OWNER=

# --- Telegram bot ------------------------------------------------------------
# @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
# Routine progress reports and daily digests require explicit opt-in.
# Interactive commands and requests for approval remain available.
TELEGRAM_AUTOMATIC_REPORTS_ENABLED=false
# Reporter (proaktivní reporty) — volitelné ladění (mají defaulty):
# TELEGRAM_REPORT_POLL_MS=8000, TELEGRAM_REPORT_MAX_PER_TICK=12,
# TELEGRAM_REPORT_THROTTLE_MS=350, TELEGRAM_AGENT_FRESH_MS=120000
# Autopilot (přeskočí schvalování specifikace globálně) se zapíná v DB:
#   farm_settings key='autopilot' value=true  (nebo per projekt trust_mode)

# --- Média (Fáze 5) ----------------------------------------------------------
FAL_API_KEY=                      # https://fal.ai  (video/obrázky)
ELEVENLABS_API_KEY=               # https://elevenlabs.io  (hudba, TTS fallback)
FISH_AUDIO_API_KEY=               # volitelné, TTS fallback
# Higgsfield (volitelná sekundární cesta) — ověř, že tvůj tarif zahrnuje API
HIGGSFIELD_API_KEY=

# --- Billing / Stripe (monetizace — Perennial) -------------------------------
# https://dashboard.stripe.com/apikeys  (použij restricted key v produkci)
STRIPE_SECRET_KEY=
# Podpisový secret webhooku (Stripe → /api/stripe/webhook). Stripe CLI / Dashboard.
STRIPE_WEBHOOK_SECRET=
# Publishable key (dashboard, volitelné pro Stripe.js)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe Price ID jednotlivých plánů (recurring, měsíční). Vytvoř v Stripe → Products.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SCALE=

# --- Deploy (Fáze 4) ---------------------------------------------------------
# Farm Dokploy (preview deploye na farm VPS)
FARM_DOKPLOY_URL=http://farm-dokploy:3000
FARM_DOKPLOY_API_KEY=
# Produkční Dokploy uživatele (jen přes approval). Per-user varianta jde do DB.
PROD_DOKPLOY_URL=
PROD_DOKPLOY_API_KEY=

# --- Runtime chování farmy ---------------------------------------------------
# AUTORITATIVNÍ zdroj stropů a limitů je tabulka `farm_settings` v DB, ne env.
# Hodnoty níž jsou jen seed pro PRVNÍ migraci prázdné databáze (migrate.ts
# zapisuje ON CONFLICT DO NOTHING, existující hodnoty v DB nikdy nepřepíše).
# Změna tady po první migraci nic nezmění — stropy se mění v DB / dashboardu.
# Výchozí hodnoty odpovídají skutečnému rozpočtu farmy (0,60 US$/den, 20 US$/měsíc,
# 1 worker) a seedu v packages/db/src/scripts/migrate.ts.
FARM_DAILY_CAP_USD=0.60
FARM_DAILY_MEDIA_CAP_USD=0.20
FARM_MONTHLY_CAP_USD=20
DEFAULT_USER_DAILY_CAP_USD=5
DEFAULT_PROJECT_DAILY_CAP_USD=3
DEFAULT_WISH_BUDGET_USD=20
PER_ATTEMPT_BUDGET_USD=0.5
MAX_WORKERS_TOTAL=1
MAX_TASK_ATTEMPTS=3
MAX_STEPS_PER_ATTEMPT=50
ATTEMPT_WALL_CLOCK_MIN=30
PGMQ_VISIBILITY_TIMEOUT_SEC=2400
REFILL_MAX_ROUNDS_PER_DAY=6
REFILL_MAX_TASKS_PER_ROUND=5
BUDGET_HOLD_RESET_TZ=UTC

# --- Worker / Docker ---------------------------------------------------------
# Runtime pro worker a judge kontejnery (na produkci: runsc = gVisor).
# Na lokálu bez gVisoru nech "runc".
WORKER_DOCKER_RUNTIME=runc
WORKER_IMAGE=agent-farm-worker:latest
# Kořen pro workspace volumes projektů (per-project izolace)
WORKSPACES_ROOT=/var/lib/agent-farm/workspaces
# Docker socket proxy (orchestrátor přes něj spouští sibling kontejnery)
DOCKER_HOST=tcp://docker-socket-proxy:2375
