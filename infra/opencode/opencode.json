{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "farm": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "{env:LITELLM_BASE_URL}/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      "models": {
        "worker": {
          "name": "worker"
        },
        "worker-hard": {
          "name": "worker-hard"
        },
        "worker-fallback": {
          "name": "worker-fallback"
        }
      }
    }
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "bash": "allow",
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny"
  },
  "autoupdate": false
}