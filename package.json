{
  "name": "agent-farm",
  "version": "0.1.0",
  "private": true,
  "description": "AgentFarm — multi-user 24/7 farma AI agentů (opencode + čínské modely)",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @farm/db generate",
    "db:migrate": "pnpm --filter @farm/db migrate",
    "db:push": "pnpm --filter @farm/db push",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "doctor": "tsx scripts/doctor.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yaml,yml}\"",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@farm/billing": "workspace:*",
    "@farm/core": "workspace:*",
    "@farm/db": "workspace:*",
    "@farm/llm": "workspace:*",
    "@farm/storage": "workspace:*",
    "@supabase/supabase-js": "^2.47.10",
    "@types/node": "^22.10.5",
    "drizzle-orm": "^0.38.3",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
